import ipywidgets as widgets
from IPython.display import display, clear_output
import math

class FiguraGeometrica:
    def __init__(self):
        self.volumen = 0.0
        self.superficie = 0.0

class Cilindro(FiguraGeometrica):
    def __init__(self, radio, altura):
        super().__init__()
        self.radio = radio
        self.altura = altura
        self.volumen = math.pi * self.altura * math.pow(self.radio, 2.0)
        self.superficie = (2.0 * math.pi * self.radio * self.altura) + (2.0 * math.pi * math.pow(self.radio, 2.0))

class Esfera(FiguraGeometrica):
    def __init__(self, radio):
        super().__init__()
        self.radio = radio
        self.volumen = (4.0/3.0) * math.pi * math.pow(self.radio, 3.0)
        self.superficie = 4.0 * math.pi * math.pow(self.radio, 2.0)

class Piramide(FiguraGeometrica):
    def __init__(self, base, altura, apotema):
        super().__init__()
        self.base = base
        self.altura = altura
        self.apotema = apotema
        self.volumen = (math.pow(self.base, 2.0) * self.altura) / 3.0
        self.superficie = math.pow(self.base, 2.0) + (2.0 * self.base * self.apotema)

class Cubo(FiguraGeometrica):
    def __init__(self, lado):
        super().__init__()
        self.lado = lado
        self.volumen = math.pow(self.lado, 3.0)
        self.superficie = 6.0 * math.pow(self.lado, 2.0)

class Prisma(FiguraGeometrica):
    def __init__(self, largo, ancho, altura):
        super().__init__()
        self.largo = largo
        self.ancho = ancho
        self.altura = altura
        self.volumen = self.largo * self.ancho * self.altura
        self.superficie = 2.0 * ((self.largo * self.ancho) + (self.largo * self.altura) + (self.ancho * self.altura))


salida_figura = widgets.Output()

def mostrar_ventana_figura(nombre_figura):
    with salida_figura:
        clear_output()
        
        lbl_titulo = widgets.HTML(f"<h3>{nombre_figura}</h3>")
